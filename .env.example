# Grafana Cloud Loki credentials — get these from:
#   Grafana Cloud → your stack → Loki → "Send Logs" (or Connections → Loki).
# Create an Access Policy / token with the `logs:write` scope.

# Loki push endpoint, e.g. https://logs-prod-012.grafana.net/loki/api/v1/push
GRAFANA_CLOUD_LOKI_URL=

# The numeric Loki "User" / instance ID shown on the Send Logs page.
GRAFANA_CLOUD_LOKI_USER=

# The Access Policy token value (acts as the basic-auth password).
GRAFANA_CLOUD_API_TOKEN=

# Label applied to every log line to identify this host.
ALLOY_HOST_LABEL=dokploy
